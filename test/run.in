#!/usr/bin/env bash

export CC4S_RUN="@FULL_RUN_CMD@"
export PYTHONPATH=@CC4S_PYTHONPATH@:$PYTHONPATH

rx=${1:?Give a regex matching the titles of the tests to run}
tags=${2:?Give tags to be ran, like 'essential and vasp' for instance}

@Python3_EXECUTABLE@ testis.py \
  -rc . \
  -n @OUTPUT_NAME@ \
  --rx "${rx}" \
  --tags "${tags}"

exit $?
