- name: Read
  in:
    fileName: "Gamma_EigenEnergies.yaml"
  out:
    destination: GammaEigenEnergies

- name: Read
  in:
    fileName: "Gamma_CoulombVertex.yaml"
  out:
    destination: GammaCoulombVertex

- name: DefineHolesAndParticles
  in:
    eigenEnergies: GammaEigenEnergies
  out:
    slicedEigenEnergies: GammaEigenEnergies

- name: SliceOperator
  in:
    slicedEigenEnergies: GammaEigenEnergies
    operator: GammaCoulombVertex
  out:
    slicedOperator: GammaCoulombVertex

- name: VertexCoulombIntegrals
  in:
    slicedCoulombVertex: GammaCoulombVertex
  out:
    coulombIntegrals: GammaCoulombIntegrals

- name: CoupledCluster
  in:
    method: Ccsd
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    slicedCoulombVertex: GammaCoulombVertex
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyCcsd
    amplitudes: GammaAmplitudes

- name: PerturbativeCT
  in:
    coulombIntegrals: GammaCoulombIntegrals
    amplitudes: GammaAmplitudes
    coulombVertex: GammaCoulombVertex
  out:
    cTIntermediate: Gammactintermediate

- name: PerturbativeTriples
  in:
    coulombIntegrals: GammaCoulombIntegrals
    amplitudes: GammaAmplitudes
    cTIntermediate: Gammactintermediate
    slicedEigenEnergies: GammaEigenEnergies
    deleteTensors: 1
  out:
    {}

- name: PerturbativeTriplesReference
  in:
    coulombIntegrals: GammaCoulombIntegrals
    cT: 1
    amplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
  out:
    {}

- name: PerturbativeTriplesReference
  in:
    coulombIntegrals: GammaCoulombIntegrals
    amplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
  out:
    {}

- name: CoupledCluster
  in:
    method: Dcsd
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyDcsd
    amplitudes: GammaLambdaAmplitudes

- name: CoupledCluster
  in:
    method: Ldrccd
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyLdrccd

- name: CoupledCluster
  in:
    method: ApxRpa
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyApxRpa

- name: CoupledCluster
  in:
    method: Ccsdt
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyCcsdt

- name: CoupledCluster
  in:
    method: Dcsdt
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyDcsdt

- name: CoupledCluster
  in:
    method: "Ccsdt-1b"
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyCcsdt1b

- name: CoupledCluster
  in:
    method: "Ccsdt-3"
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyCcsdt3

- name: CoupledCluster
  in:
    method: "3CC"
    tAmplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergy3CC


- name: CoupledCluster
  in:
    method: LambdaCcsd
    tAmplitudes: GammaAmplitudes
    algo: LambdaCcsd
    slicedEigenEnergies: GammaEigenEnergies
    coulombIntegrals: GammaCoulombIntegrals
    integralsSliceSize: 100
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: GammaEnergyLambdaCcsd
    amplitudes: GammaLambdaAmplitudes

- name: PerturbativeTriplesReference
  in:
    coulombIntegrals: GammaCoulombIntegrals
    lambda: 1
    lambdaAmplitudes: GammaLambdaAmplitudes
    amplitudes: GammaAmplitudes
    slicedEigenEnergies: GammaEigenEnergies
  out:
    {}

- name: CcsdtNonit
  in:
    slicedEigenEnergies: GammaEigenEnergies
    amplitudes: GammaAmplitudes
    coulombIntegrals: GammaCoulombIntegrals
    lambdaAmplitudes: GammaLambdaAmplitudes
  out:
    energy: GammaCcsdtNonitEnergy

- name: CcsdtNonit
  in:
    slicedEigenEnergies: GammaEigenEnergies
    amplitudes: GammaAmplitudes
    coulombIntegrals: GammaCoulombIntegrals
    lambdaAmplitudes: GammaLambdaAmplitudes
    t3t3mode: "3CC"
  out:
    energy: GammaCcsdtNonitEnergy3CC


################################################################################
# STD version with complex integrals
################################################################################

- name: Read
  in:
    fileName: "STD_EigenEnergies.yaml"
