- name: Read
  in:
    fileName: "EigenEnergies.yaml"
  out:
    destination: EigenEnergies

- name: Read
  in:
    fileName: "CoulombIntegrals.yaml"
  out:
    destination: CoulombIntegrals

- name: DefineHolesAndParticles
  in:
    eigenEnergies: EigenEnergies
  out:
    slicedEigenEnergies: EigenEnergies

- name: CoupledCluster
  in:
    method: Ccsd
    integralsSliceSize: 50
    slicedEigenEnergies: EigenEnergies
    coulombIntegrals: CoulombIntegrals
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: CcsdEnergy
    amplitudes: Amplitudes

- name: CoupledCluster
  in:
    method: Ccsdt
    integralsSliceSize: 50
    slicedEigenEnergies: EigenEnergies
    coulombIntegrals: CoulombIntegrals
    maxIterations: 20
    energyConvergence: 1.0E-8
    amplitudesConvergence: 1.0E-8
    mixer:
      type: DiisMixer
      maxResidua: 4
  out:
    energy: CcsdEnergy
    amplitudes: Amplitudes


